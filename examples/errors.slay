# shoot = try, fumble = except, periodt = finally, yeet = raise, ongod = assert

blueprint RatioError(Exception):
    chill


cook post(likes, replies):
    fr replies > likes:
        yeet RatioError(f"got ratioed: {replies} replies vs {likes} likes")
    serve "W post"


doomscroll likes, replies in [(100, 3), (5, 80)]:
    shoot:
        yap(post(likes, replies))
    fumble RatioError aka e:
        yap("L:", e)
    periodt:
        yap("next post...")

score = 10
ongod score > 0, "score can't be negative, that's cap"
yap("ongod check passed")
