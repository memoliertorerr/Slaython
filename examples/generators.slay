# drop = yield, lockedin = while, dip = break, anyways = continue


cook feed():
    n = 0
    lockedin nocap:
        n += 1
        drop f"post #{n}"


cook doomscroll_session(limit):
    doomscroll post in feed():
        fr post.endswith("3"):
            anyways          # skip the boring one
        yap("scrolling:", post)
        fr post == f"post #{limit}":
            dip              # touch grass
    yap("ok that's enough screen time")


doomscroll_session(5)
